# TEST-ONLY ENVIRONMENT FILE. Deliberately (almost) empty. Never put a real value here.
#
# phpunit.xml sets APP_ENV=testing, and Laravel then loads THIS file instead of .env
# (Illuminate\Foundation\Bootstrap\LoadEnvironmentVariables). So no value from the live .env
# (mail and database credentials, APP_KEY, APP_URL, addresses, limits) can reach a test, today
# or after a new key is added to .env.
#
# Every value the tests need is set in phpunit.xml (force="true"), which also reaches child
# processes started by tests. Anything not set there falls back to the defaults in config/*.php,
# which hold no secrets. tests/TestCase.php refuses to run if this file was not the one loaded.
