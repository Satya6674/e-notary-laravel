# E-Notary production environment TEMPLATE. Copy to .env on the server and replace every <...> value.
# Never commit the filled-in file. Never reuse the development APP_KEY, database or mail credentials.
# Then run:  php artisan enotary:deploy-check   (must report 0 FAIL before the site is opened)
#
# Values still required from the owner are marked REQUIRED.

APP_NAME=E-Notary
APP_ENV=production
APP_DEBUG=false
# REQUIRED: generate on the server with  php artisan key:generate --show  (store it in a password manager)
APP_KEY=<new-base64-key>
# REQUIRED: the real public domain, https only. Email links are built from this value.
APP_URL=https://<your-domain>
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# How TLS reaches the app (read via config/trustedproxy.php, so it works with config:cache).
# Choose ONE; enotary:deploy-check warns until an HTTPS site declares it:
#   DIRECT TLS (this server holds the certificate, nothing in front):   TRUSTED_PROXIES=none
#     ("none" trusts no proxy on any host. Leaving the value EMPTY is not the same on Laravel Cloud or
#      *.on-forge.com / *.on-vapor.com hosts: there Laravel itself trusts the connecting address.)
#   REVERSE PROXY / LOAD BALANCER terminating TLS: its address(es) or CIDR range, comma-separated:
#     same-server proxy (nginx/Caddy):  127.0.0.1,::1
#     cloud load balancer:              its private subnet, e.g. 10.0.0.0/8
#     Cloudflare in front:              Cloudflare's published ranges plus your load balancer
# Only X-Forwarded-For and X-Forwarded-Proto are believed from a listed proxy; X-Forwarded-Port,
# -Host, -Prefix and "Forwarded" never are. The proxy must SET X-Forwarded-Proto and APPEND to
# X-Forwarded-For. Do NOT use "*", REMOTE_ADDR, 0.0.0.0/0 or ::/0 (they trust whichever address
# connects directly) unless the app port is firewalled so only the proxy can reach it; PRIVATE_SUBNETS
# trusts every private address. Replace the placeholder below. Run config:cache after changes.
TRUSTED_PROXIES=<proxy-ip-or-cidr-or-none>

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# REQUIRED: a dedicated MariaDB database and the restricted application account (DML only).
# Migrations run with a separate migrator account (it also needs the TRIGGER privilege).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<enotary_production>
DB_USERNAME=<enotary_app>
DB_PASSWORD=<app-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Admin security
ADMIN_MFA_REQUIRED=true
ADMIN_REAUTH_MINUTES=10
PROTECTED_ACCOUNTS=<permanent-admin-email>

# Email. REQUIRED: a sending service for the real domain (SPF/DKIM/DMARC). A personal Gmail account
# (about 500 messages/day) is not suitable for 100 users. Live Mail sends only the listed business emails.
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=<no-reply@your-domain>
MAIL_FROM_NAME="E-Notary"
MAIL_ADMIN_ADDRESS=<admin-inbox@your-domain>
MAIL_SUPPORT_ADDRESS=<support@your-domain>
LIVE_MAIL_ENABLED=true
LIVE_MAIL_RECIPIENTS=any
LIVE_MAIL_ALLOW_PERMANENT_DATABASE=false
MAIL_NOTIFY_ADMIN_NEW_CITIZENS=false

# Emailed-code ceilings (per day): site-wide, per account and flow, per IP.
EMAIL_CODE_DAILY_SITE=300
EMAIL_CODE_DAILY_PER_ACCOUNT=10
EMAIL_CODE_DAILY_PER_IP=30
OTP_TTL_MINUTES=10

# SMS stays off (no DLT registration). Leave the key empty.
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
CITIZEN_MOBILE_VERIFICATION_REQUIRED=false
MOBILE_EMAIL_FALLBACK=true
