APP_NAME="E-Notary"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the address you open in the browser; queued emails build links from it.
APP_URL=http://127.0.0.1:8000

# Reverse proxy / load balancer in front of the app (config/trustedproxy.php):
#   empty  nothing declared; no proxy trusted, forwarded headers ignored (fine locally: XAMPP, artisan serve).
#          Laravel's own exception: on Laravel Cloud and *.on-forge.com / *.on-vapor.com hosts it then trusts
#          the connecting address (its platform proxy).
#   none   direct TLS: this server terminates HTTPS itself (e.g. Apache with its certificate); no proxy
#          trusted on any host, platform hosts included
#   list   the proxy's address(es) or CIDR range, comma-separated, e.g. 127.0.0.1,::1 or 10.0.0.0/8
# Only X-Forwarded-For and X-Forwarded-Proto are believed, and only from a listed proxy.
# Avoid "*" (and REMOTE_ADDR, 0.0.0.0/0, ::/0): they trust any directly connecting client.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Permanent Admin account(s) that no other Admin can edit, deactivate or delete: comma-separated
# email addresses, matched without case. Invalid entries are ignored and reported by
# php artisan enotary:deploy-check. Empty = no account is protected. Example: admin@example.com
PROTECTED_ACCOUNTS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enotary
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "database" queues emails; run: php artisan queue:work --tries=3
# "sync" sends emails inline during the request (no worker needed, slower pages).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Email (Gmail SMTP for demo) ----------------------------------------
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:     https://myaccount.google.com/apppasswords
# 3. Put the 16-character App Password in MAIL_PASSWORD (never commit it).
# Use "log" to write emails to storage/logs/laravel.log instead of sending.
# Local Gmail mode is switched on by scripts/Start-Local-Gmail.ps1, not here, so the
# site Apache serves from this file is never affected.
# Set true to tell administrators about every new Citizen account.
# MAIL_NOTIFY_ADMIN_NEW_CITIZENS=false
# Safe Preview is the default: with LIVE_MAIL_ENABLED=false nothing is sent, whatever MAIL_MAILER says.
# Live Mail sends only the notification types listed in App\Support\Platform::LIVE_MAIL_NOTIFICATIONS,
# only to OUTBOUND_ALLOW_MAIL (unless LIVE_MAIL_RECIPIENTS=any), and nothing if a setting below is missing.
# LIVE_MAIL_RECIPIENTS=allowlist
# ADMIN_MFA_REQUIRED=false
# SCHEDULER_SAFE_MODE=true
LIVE_MAIL_ENABLED=false
# OUTBOUND_ALLOW_MAIL=tester@example.com
MAIL_MAILER=log
MAIL_TIMEOUT=15
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sender@example.com
MAIL_PASSWORD=your-google-app-password
# Gmail replaces the From address unless it equals MAIL_USERNAME.
MAIL_FROM_ADDRESS=sender@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Optional: where contact-form copies go (empty: the active Admin accounts) / support address shown in emails.
MAIL_ADMIN_ADDRESS=
MAIL_SUPPORT_ADDRESS=
# Contact-form acknowledgements the whole site may send per 24 h (one per address per day regardless).
# CONTACT_ACK_DAILY_LIMIT=100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- SMS OTP (MSG91) -----------------------------------------------------
# false keeps the auth key out of the running configuration, so no SMS can be attempted.
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Set only after DLT approval. Real SMS then replaces the local simulation, once MSG91 also
# accepts the account. The DLT IDs are the ones entered in the MSG91 panel.
# MSG91_PRODUCTION_READY=false
# MSG91_DLT_PE_ID=
# MSG91_DLT_TEMPLATE_ID=
# Real SMS is refused unless OUTBOUND_ALLOW_SMS and a budget above 0 are both set.
# For an approved live test, this is the most SMS one approval may send, counted under its id.
# MSG91_SEND_BUDGET=1
# Minutes a code stays valid. Must match the wording of the MSG91 template.
# OTP_TTL_MINUTES=10
# MSG91_BUDGET_ID=
